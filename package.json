{
  "name": "resolve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern extension/dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "node scripts/test-database.mjs",
    "identity:check": "node scripts/check-identity.mjs",
    "test:all": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:db && npm run identity:check && npm run extension:build && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply resolve-local --config wrangler.local.jsonc --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute resolve-local --config wrangler.local.jsonc --local --persist-to .wrangler/state --file drizzle/0001_showcase.sql",
    "data:refresh": "node scripts/build-showcase-data.mjs && node scripts/generate-showcase-sql.mjs",
    "data:sprint": "node scripts/generate-cp31-sprint-sql.mjs",
    "export:local": "node scripts/export-local.mjs",
    "extension:build": "node extension/build.mjs",
    "extension:package": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "drizzle-orm": "0.45.2",
    "idb-keyval": "6.2.2",
    "katex": "0.16.22",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "0.16.7",
    "@types/chrome": "0.0.316",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.7.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "4.0.16",
    "wrangler": "4.92.0"
  }
}
