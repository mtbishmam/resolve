{
  "manifest_version": 3,
  "name": "ReSolve Capture",
  "version": "0.3.1",
  "description": "Track local ReSolve mashup time on judge pages and capture Codeforces statements.",
  "homepage_url": "https://resolve.mtbishmam.chatgpt.site",
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "http://localhost/*",
    "https://*.codeforces.com/*",
    "https://atcoder.jp/*",
    "https://cses.fi/*",
    "https://*.codechef.com/*",
    "https://lightoj.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.codeforces.com/contest/*/problem/*",
        "https://*.codeforces.com/gym/*/problem/*",
        "https://*.codeforces.com/problemset/problem/*",
        "https://atcoder.jp/contests/*/tasks/*",
        "https://cses.fi/problemset/task/*",
        "https://*.codechef.com/*problems/*",
        "https://lightoj.com/problem/*"
      ],
      "js": ["timer-page.js"]
    }
  ],
  "action": {
    "default_title": "ReSolve mashup timer and capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
